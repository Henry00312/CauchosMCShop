# Contexto de build del frontend.
#
# Sin este archivo, "COPY . ." arrastra el node_modules del host: infla el
# contexto y falla al transferir los enlaces simbolicos de node_modules/.bin
# ("invalid file request node_modules/.bin/acorn").

# Dependencias: se instalan dentro de la imagen con yarn install.
node_modules
**/node_modules

# Salida de compilacion: la regenera "yarn build" dentro de la imagen.
dist

# Metadatos de control de versiones.
.git
.gitignore
.gitattributes

# Logs y volcados de diagnostico.
*.log
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Artefactos de pruebas y cobertura.
coverage
.nyc_output

# Configuracion de editores y del sistema operativo.
.vscode
.idea
.DS_Store
Thumbs.db

# El propio contexto de Docker no necesita copiarse dentro de la imagen.
Dockerfile
.dockerignore

# NOTA: los archivos .env NO se excluyen aqui, a diferencia del backend.
#
# Vue CLI resuelve las variables VUE_APP_* en tiempo de BUILD: webpack las
# sustituye literalmente dentro del bundle. El servicio frontend del compose no
# define env_file ni build args, asi que este .env es su unica fuente. Al
# excluirlo, el build sigue completando sin error pero emite "undefined/api/..."
# en cada llamada, dejando la aplicacion inservible de forma silenciosa.
#
# No supone exposicion de secretos: todo valor VUE_APP_* acaba en el bundle que
# se sirve al navegador, es decir es publico por construccion.
#
# Para poder excluirlo habria que pasar la variable como build arg en el
# Dockerfile y el compose; queda como cambio aparte, fuera de este commit.
