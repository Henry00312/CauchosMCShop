# Aplicación Express
PORT=
HOST=

# Conexiones de la aplicación
MONGODB_URI=
RABBITMQ_URI=

# Mercado Pago
# MP_MODE selecciona la credencial usada en todo el flujo (creación de
# preferencias y consulta de pagos del webhook). Ambas operaciones deben usar
# la misma cuenta o el pedido no llega a registrarse.
#   test        -> usa MERCADOPAGO_KEY_TEST
#   production  -> usa MERCADOPAGO_KEY
# Si se omite se asume "test" y se emite una advertencia al arrancar.
MP_MODE=test
MERCADOPAGO_KEY=
MERCADOPAGO_KEY_TEST=

# Autenticación actual
TOKEN_KEY=
OwA=
AM=
ENTMANG=

# Correo de contacto
GMAIL_USER=
GMAIL_PASS=

# Las credenciales contenidas en MONGODB_URI y RABBITMQ_URI deben corresponder
# a los servicios provisionados en el entorno de despliegue.
